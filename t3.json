{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "assets/dev/blueprint-web-apple-touch-180.png",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "vp i && ln -sf $T3CODE_PROJECT_ROOT/.env .env && ln -sf $T3CODE_PROJECT_ROOT/infra/relay/.env infra/relay/.env",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "Deploy to Vision Pro",
      "command": "./apps/vision/publish.sh",
      "icon": "build"
    },
    {
      "name": "Deploy to Vision Pro (with logs)",
      "command": "./apps/vision/publish.sh --logs",
      "icon": "debug"
    }
  ]
}
